@model Department

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="h2 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">
            Department ID: @Model.Id
        </p>
    </div>

    <a class="btn btn-outline-secondary"
       asp-action="Index">
        Back to Departments
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <h2 class="h5 mb-3">Students in this Department</h2>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Grade</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (Student student in ViewBag.Students)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>@student.Name</td>
                            <td>@student.Age</td>
                            <td>@student.Grade</td>

                            <td>
                                @if (student.Status == StudentStatus.Active)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else if (student.Status == StudentStatus.Graduated)
                                {
                                    <span class="badge bg-primary">
                                        Graduated
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Suspended
                                    </span>
                                }
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>