@model Student

<div class="mb-4">
    <h1 class="h2 mb-1">Student Details</h1>
    <p class="text-muted">Student record found from your search.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">

        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <small class="text-muted">Student ID</small>
                <p class="fw-semibold mb-0">@Model.Id</p>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Name</small>
                <p class="fw-semibold mb-0">@Model.Name</p>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Age</small>
                <p class="fw-semibold mb-0">@Model.Age</p>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Grade</small>
                <p class="fw-semibold mb-0">@Model.Grade</p>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Status</small>

                <div>
                    @if (Model.Status == StudentStatus.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else if (Model.Status == StudentStatus.Graduated)
                    {
                        <span class="badge bg-primary">Graduated</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Suspended</span>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Department</small>
                <p class="fw-semibold mb-0">
                    @Model.Department?.Name
                </p>
            </div>

        </div>

        <div class="d-flex gap-2">

            <a class="btn btn-primary"
               asp-action="Edit"
               asp-route-id="@Model.Id">
                Edit Student
            </a>

            <a class="btn btn-outline-danger"
               asp-action="Delete"
               asp-route-id="@Model.Id">
                Delete
            </a>

            <a class="btn btn-outline-secondary"
               asp-action="Index">
                Back to Students
            </a>

        </div>

    </div>
</div>