@model List<Student>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h1 class="h2 mb-1">Students</h1>
		<p class="text-muted mb-0">
			Manage student records and academic information.
		</p>
	</div>

	<a class="btn btn-primary" asp-action="Create">
		+ Add Student
	</a>
</div>
	

<div class="card shadow-sm mb-4">
	<div class="card-body">
        <h5 class="mb-3">Search & Filter</h5>

        <form method="get" asp-action="Search" class="row g-2 align-items-end mb-4">
            <div class="col-md-9">
                <label class="form-label">Student ID</label>
                <input class="form-control"
                       type="number"
                       name="id"
                       placeholder="Enter student ID" />
            </div>

            <div class="col-md-3">
                <button class="btn btn-outline-primary w-100"
                        type="submit">
                    Search
                </button>
            </div>
        </form>

        <form method="get" asp-action="Index" class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label">Department</label>

                <select class="form-select" name="departmentId">
                    <option value="">All Departments</option>

                    @foreach (Department department in ViewBag.Departments)
                    {
                        if (ViewBag.SelectedDepartmentId == department.Id)
                        {
                            <option value="@department.Id" selected>
                                @department.Name
                            </option>
                        }
                        else
                        {
                            <option value="@department.Id">
                                @department.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>

                <select class="form-select" name="status">
                    <option value="">All Statuses</option>

                    @foreach (StudentStatus status in Enum.GetValues<StudentStatus>())
                    {
                        if (ViewBag.SelectedStatus == status)
                        {
                            <option value="@status" selected>
                                @status
                            </option>
                        }
                        else
                        {
                            <option value="@status">
                                @status
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1"
                        type="submit">
                    Filter
                </button>

                <a class="btn btn-outline-secondary"
                   asp-action="Index">
                    Clear
                </a>
            </div>

        </form>
	</div>
</div>

<div class="mb-3">
    <a class="btn btn-outline-success" asp-action="Passed">
        Passed Students
    </a>
</div>


<div class="table-responsive">
	<table class="table table-hover align-middle">
		<thead class="table-light">
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Age</th>
				<th>Grade</th>
				<th>Status</th>
				<th>Department</th>
				<th>Actions</th>
			</tr>
		
		</thead>
		<tbody>
			@foreach (Student student in Model)
			{
				<tr>
					<td>@student.Id</td>
					<td>@student.Name</td>
					<td>@student.Age</td>
					<td>@student.Grade</td>
                    <td>
                        @if (student.Status == StudentStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (student.Status == StudentStatus.Graduated)
                        {
                            <span class="badge bg-primary">Graduated</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Suspended</span>
                        }
                    </td>
					<td>@student.Department?.Name</td>
					<td>
						<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@student.Id">Edit</a>

						<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@student.Id">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

