@model Student

<div class="mb-4">
    <h1 class="h2 mb-1">Add Student</h1>
    <p class="text-muted">Create a new student record.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">

        <form method="post">

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" asp-for="Name" />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Age</label>
                <input class="form-control" asp-for="Age" />
                <span class="text-danger" asp-validation-for="Age"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Grade</label>
                <input class="form-control" asp-for="Grade" />
                <span class="text-danger" asp-validation-for="Grade"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select class="form-select"
                        asp-for="Status"
                        asp-items="Html.GetEnumSelectList<StudentStatus>()">
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Department</label>

                <select class="form-select" asp-for="DepartmentId">
                    <option value="">Select Department</option>

                    @foreach (Department department in ViewBag.Departments)
                    {
                        <option value="@department.Id">
                            @department.Name
                        </option>
                    }
                </select>

                <span class="text-danger"
                      asp-validation-for="DepartmentId"></span>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">
                    Add Student
                </button>

                <a class="btn btn-outline-secondary"
                   asp-action="Index">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>